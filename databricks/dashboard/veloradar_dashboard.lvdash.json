{
  "datasets": [
    {
      "name": "825a2197",
      "displayName": "passes_by_hour",
      "queryLines": [
        "SELECT *\r\n",
        "FROM veloradar.gold.passes_by_hour\r\n",
        "ORDER BY hour_local"
      ]
    },
    {
      "name": "837ccc47",
      "displayName": "speed_by_direction",
      "queryLines": [
        "SELECT\r\n",
        "  CASE direction\r\n",
        "    WHEN 'left_to_right' THEN 'Left → Right'\r\n",
        "    WHEN 'right_to_left' THEN 'Right → Left'\r\n",
        "    ELSE direction\r\n",
        "  END AS direction,\r\n",
        "  total_passes,\r\n",
        "  avg_speed_kmh,\r\n",
        "  max_speed_kmh,\r\n",
        "  min_speed_kmh,\r\n",
        "  avg_elapsed_ms\r\n",
        "FROM veloradar.gold.speed_by_direction"
      ]
    },
    {
      "name": "d46e3cc6",
      "displayName": "speed_distribution",
      "queryLines": [
        "SELECT *\r\n",
        "FROM veloradar.gold.speed_distribution\r\n",
        "ORDER BY speed_band_start_kmh"
      ]
    }
  ],
